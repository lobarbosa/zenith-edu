# Copie para .env.local e preencha com os valores do projeto Supabase e da Anthropic.
# .env.local nunca é commitado (ver .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só usada em route handlers no servidor — bypassa RLS. Usada hoje só em
# /mentor e /api/mentor/validate.
SUPABASE_SERVICE_ROLE_KEY=

# Usada em /api/diagnostic (conversa e classificação de bloco) e
# /api/profile (síntese do Perfil Executivo).
ANTHROPIC_API_KEY=

# Lista de e-mails autorizados a acessar /mentor, separados por vírgula.
# Allowlist mínima da Fase 0 — sem tabela de papel (ver docs/ARCHITECTURE.md §6).
MENTOR_EMAILS=
